{
  "Id":"Б1.В.ДВ.08.01",
  "Name":"Экономика организаций атомной отрасли и научно-производственных комплексов",
  "EducationProgram":"<<Высокопроизводительные вычисления и технологии параллельного программирования>>",
  "TrainingDirection":"01.03.02 <<Прикладная математика и информатика>>",
